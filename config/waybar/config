{
  "layer": "top",
  "position": "top",
  "height": 30,

  "output": [
    "DP-1",
    "HDMI-A-1"
  ],

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  
  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "custom/kb_layout",
    "custom/mic",
    "pulseaudio",
    "custom/audio-toggle"
  ],

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "hyprland/window": {
    "format": "{title}",
    "rewrite": {
      "(.*)": "$1"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "interval": 60,
    "tooltip-format": "<big>{:%Y %B %d}</big>\n<tt><small>{calendar}</small></tt>"  // Optional tooltip with date/calendar
  },
  
  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "󰤭  Disconnected",
    "tooltip": true
  },
  "custom/kb_layout": {
    "exec": "hyprctl devices -j | jq -r '.keyboards[] | select(.main==true) | .active_keymap' | awk '{print tolower(substr($0,1,2))}'",
    "interval": 1,
    "format": "{}",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "pulseaudio": {
    "format": "󰕾  {volume}%",
    "format-muted": "󰝟  Muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    }
  },
  "custom/audio-toggle": {
	  "exec": "~/env/scripts/toggle-audio.sh",
	  "interval": 1,
	  "on-click": "~/env/scripts/toggle-audio.sh toggle",
	  "return-type": "text",
	  "tooltip": "Click to toggle audio output"
  },
  "custom/mic": {
	  "exec": "~/env/scripts/mic-status.sh",
	  "interval": 1,
	  "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
	  "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
	  "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },
  "hyprland/workspaces": {
	  "format": "{name}",
	  "on-click": "activate",
	  "sort-by-number": true,
	  "active-only": false,
	  "all-outputs": false,
	  "persistent-workspaces": {
		  "1": [],
		  "2": [],
		  "3": [],
		  "4": [],
		  "5": []
	  }
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-disabled": " off",
    "on-click": "blueman-manager"

  }
}

