/*
 * Timer.
 * Small bottom-centered floating card.
 * Shares the launcher/power-menu palette.
 */

@import "colors.rasi"

configuration {
    show-icons: false;
}

* {
    font: "Agave Nerd Font Propo 26";
}

/*****----- Card -----*****/
window {
    width: 360px;
    height: 220px;

    location: south;
    anchor: south;

    y-offset: -35px;

    padding: 26px;

    border-radius: 24px;
    border: 1px;
    border-color: var(border-strong);

    background-color: var(bg);

    cursor: default;
}

mainbox {
    background-color: transparent;

    spacing: 18px;

    children: [
        "inputbar",
        "listview"
    ];
}

/*****----- Heading -----*****/
inputbar {
    background-color: transparent;

    children: [
        "prompt"
    ];
}

prompt {
    background-color: transparent;

    text-color: var(fg);

    font: "GeistMono Nerd Font Propo 17";

    horizontal-align: 0.5;
}

/*****----- Minute selector -----*****/
listview {
    background-color: transparent;

    columns: 1;
    lines: 5;

    spacing: 7px;

    cycle: true;
    dynamic: true;
    scrollbar: false;

    layout: vertical;

    fixed-height: true;
    fixed-columns: true;

    cursor: default;
}

element {
    background-color: var(bg-raised);

    text-color: var(fg-dim);

    padding: 10px 18px;

    border-radius: 12px;

    border: 1px;
    border-color: var(border-color);

    cursor: pointer;
}

element selected.normal {
    background-color: var(accent-soft);

    text-color: var(accent);

    border-color: var(accent);
}

element-text {
    background-color: transparent;

    text-color: inherit;

    font: inherit;

    vertical-align: 0.5;
    horizontal-align: 0.5;

    cursor: inherit;
}
