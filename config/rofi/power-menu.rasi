/*
 * Power menu.
 * Floating card with a centered row of round action buttons.
 * Shares the launcher's palette and radii.
 */
@import "colors.rasi"

configuration {
    show-icons:                  false;
}

* {
    font:                        "Agave Nerd Font Propo 26";
}

/*****----- Card -----*****/
window {
    width:                       620px;
    location:                    center;
    anchor:                      center;
    padding:                     30px;
    border-radius:               24px;
    border:                      1px;
    border-color:                var(border-strong);
    background-color:            var(bg);
    cursor:                      "default";
}

mainbox {
    background-color:            transparent;
    spacing:                     22px;
    children:                    [ "inputbar", "listview", "message" ];
}

/*****----- Heading -----*****/
inputbar {
    background-color:            transparent;
    children:                    [ "prompt" ];
}
prompt {
    background-color:            transparent;
    text-color:                  var(fg);
    font:                        "GeistMono Nerd Font Propo 17";
    horizontal-align:            0.5;
}

/*****----- Action buttons -----*****/
listview {
    background-color:            transparent;
    columns:                     5;
    lines:                       1;
    spacing:                     14px;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
}

element {
    background-color:            var(bg-raised);
    text-color:                  var(fg-dim);
    padding:                     32px 0px;
    border-radius:               999px;
    border:                      1px;
    border-color:                var(border-color);
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    cursor:                      inherit;
}
element selected.normal {
    background-color:            var(accent-soft);
    text-color:                  var(accent);
    border-color:                var(accent);
}

/*****----- Uptime footer -----*****/
message {
    background-color:            transparent;
    padding:                     0px;
}
textbox {
    background-color:            transparent;
    text-color:                  var(fg-dim);
    font:                        "GeistMono Nerd Font Propo 11";
    horizontal-align:            0.5;
    vertical-align:              0.5;
}
