* {
    font: "Inter 14";

    bg:             #0e0e11f7;
    bg-raised:      #17171ce0;
    bg-alt:         #1c1c22f5;

    fg:             #f2f2f5;
    fg-dim:         #8b8b97;

    accent:         #7aa2f7;
    accent-soft:    #7aa2f726;
    accent-purple:  #9575cd;
    accent-green:   #8bd49c;
    accent-red:     #ff6c6c;
    accent-yellow:  #e0af68;

    border-color:   #ffffff1c;
    border-strong:  #ffffff24;
    on-accent:      #0d1017;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 440px;
    location: center;
    anchor: center;

    padding: 24px 24px 30px 24px;

    border: 1px;
    border-color: @border-strong;
    border-radius: 16px;

    background-color: @bg;
}

mainbox {
    orientation: vertical;
    spacing: 20px;

    children: [ prompt, entry ];

    padding: 2px 2px 6px 2px;
    background-color: transparent;
}

prompt {
    enabled: true;

    text-color: @fg;

    padding: 2px 0px;
    background-color: transparent;
}

entry {
    enabled: true;

    placeholder: "Enter password";
    placeholder-color: @fg-dim;

    width: 100%;
    padding: 12px 16px;

    border: 1px;
    border-color: @accent;
    border-radius: 10px;

    background-color: @bg-raised;
    text-color: @fg;

    cursor: text;
}

textbox-prompt-colon {
    enabled: false;
}

inputbar {
    background-color: transparent;
    text-color: @fg;
}

listview {
    enabled: false;
}

message {
    enabled: false;
}

mode-switcher {
    enabled: false;
}

button {
    enabled: false;
}

element {
    enabled: false;
}

