/*
 * Notes panel.
 * Right-side floating card with clean task rows.
 * Shares the launcher's palette, typography and radii.
 */

@import "colors.rasi"

configuration {
    show-icons: false;
}

* {
    font: "Agave Nerd Font Propo 14";
}

/*****----- Notes card -----*****/
window {
    width: 920px;
    height: 40%;
    location: center;
    anchor: center;

    x-offset: -18px;
    y-offset: 0px;

    padding: 26px;

    border-radius: 24px;
    border: 1px;
    border-color: var(border-strong);

    background-color: var(bg);

    cursor: default;
}

mainbox {
    background-color: transparent;

    spacing: 18px;

    children: [
        "listview",
        "message"
    ];
}

/*****----- Task list -----*****/
listview {
    background-color: transparent;

    columns: 1;
    lines: 12;

    spacing: 7px;

    cycle: true;
    dynamic: true;
    scrollbar: false;

    layout: vertical;

    fixed-height: false;
    fixed-columns: true;

    cursor: default;
}

/*****----- Task row -----*****/
element {
    background-color: var(bg-raised);

    text-color: var(fg-dim);

    padding: 13px 16px;

    border-radius: 12px;

    border: 1px;
    border-color: var(border-color);

    cursor: pointer;
}

element normal {
    background-color: var(bg-raised);
    text-color: var(fg-dim);
}

element selected.normal {
    background-color: var(accent-soft);

    text-color: var(accent);

    border-color: var(accent);
}

element-text {
    background-color: transparent;

    text-color: inherit;

    font: inherit;

    vertical-align: 0.5;
    horizontal-align: 0.0;

    cursor: inherit;
}

/*****----- Add note -----*****/
element normal.active {
    background-color: var(bg-raised);
    text-color: var(fg-dim);
}

element-text selected {
    text-color: var(accent);
}

/*****----- Footer -----*****/
message {
    background-color: transparent;

    padding: 4px 8px;
}

textbox {
    background-color: transparent;

    text-color: var(fg-dim);

    font: "GeistMono Nerd Font Propo 10";

    horizontal-align: 0.0;
    vertical-align: 0.5;
}
